{"source":"chunk-1","from":0,"text":"Патч двадцать шесть точка девятнадцать. Главное ослабление — Ноктюрн. Перезарядка «Паранойи» выросла: на первом ранге — со ста сорока до ста шестидесяти секунд, на втором — до ста тридцати, на третьем — до ста. Атроксу, наоборот, ускорили «Проклятые цепи», а Райзу поменяли броню и стоимость «Волшебного потока».","start":[0,0.09,0.18,0.27,0.36,0.36,0.414,0.469,0.523,0.577,0.631,0.686,0.74,0.794,0.794,0.852,0.91,0.968,1.026,1.084,1.084,1.141,1.199,1.257,1.315,1.373,1.373,1.425,1.477,1.53,1.582,1.634,1.686,1.739,1.791,1.843,1.895,1.948,2,2,2,2.174,2.349,2.523,2.697,2.871,3.046,3.22,3.22,3.294,3.368,3.442,3.516,3.59,3.664,3.738,3.812,3.886,3.96,3.96,3.96,4.3,4.409,4.517,4.626,4.734,4.843,4.951,5.06,5.06,5.32,5.384,5.447,5.511,5.575,5.638,5.702,5.765,5.829,5.893,5.956,6.02,6.02,6.08,6.148,6.215,6.283,6.35,6.418,6.485,6.553,6.62,6.62,6.64,6.714,6.789,6.863,6.937,7.011,7.086,7.16,7.16,7.16,7.37,7.58,7.58,7.647,7.713,7.78,7.847,7.913,7.98,7.98,8.048,8.116,8.184,8.252,8.32,8.32,8.32,8.32,8.48,8.64,8.64,8.693,8.747,8.8,8.8,8.847,8.893,8.94,8.987,9.033,9.08,9.08,9.3,9.52,9.52,9.555,9.59,9.625,9.625,9.654,9.682,9.711,9.74,9.768,9.797,9.825,9.854,9.883,9.911,9.94,9.94,10.137,10.333,10.53,10.727,10.923,11.12,11.12,11.12,11.23,11.34,11.34,11.413,11.487,11.56,11.633,11.707,11.78,11.78,11.78,11.98,12.02,12.06,12.06,12.158,12.257,12.355,12.355,12.438,12.522,12.605,12.688,12.771,12.854,12.937,13.02,13.02,13.02,13.14,13.26,13.26,13.331,13.403,13.474,13.546,13.617,13.689,13.76,13.76,13.76,13.94,14,14.06,14.06,14.16,14.26,14.36,14.36,14.36,14.503,14.646,14.789,14.931,15.074,15.217,15.36,15.36,15.36,15.418,15.475,15.532,15.59,15.648,15.705,15.763,15.82,15.82,16.04,16.105,16.17,16.235,16.3,16.365,16.43,16.495,16.56,16.56,16.56,16.622,16.684,16.747,16.809,16.871,16.933,16.996,17.058,17.12,17.12,17.25,17.38,17.51,17.64,17.64,17.64,17.72,17.9,17.9,17.98,18.06,18.14,18.22,18.3,18.3,18.358,18.415,18.473,18.53,18.588,18.645,18.703,18.76,18.76,18.848,18.936,19