{"source":"chunk-4","from":43.048,"text":"Второе место — Пират Воин. В августе он стремительно ворвался в Стандарт с новым геймплеем вокруг Канониров. Мало того, что они агрессивно захватывают стол и наносят много урона, так ещё и могут устроить огромный взрывной урон вместе с Ручницей. Проигрывает Пират Воин Друиду на атаке — именно этот матч-ап и определил, кто станет лидером меты.","start":[0,0.097,0.193,0.29,0.387,0.483,0.58,0.58,0.636,0.692,0.748,0.804,0.86,0.86,0.86,1.56,1.64,1.72,1.8,1.88,1.96,1.96,2.1,2.24,2.38,2.52,2.52,2.52,3.14,3.14,3.214,3.289,3.363,3.437,3.511,3.586,3.66,3.66,3.74,3.82,3.82,3.87,3.92,3.97,4.02,4.07,4.12,4.17,4.22,4.27,4.32,4.37,4.42,4.42,4.483,4.545,4.608,4.67,4.733,4.795,4.858,4.92,4.92,5.02,5.02,5.078,5.135,5.193,5.25,5.308,5.365,5.423,5.48,5.48,5.78,5.78,5.84,5.9,5.96,6.02,6.08,6.08,6.147,6.213,6.28,6.347,6.413,6.48,6.547,6.613,6.68,6.68,6.723,6.767,6.81,6.853,6.897,6.94,6.94,7.007,7.073,7.14,7.207,7.273,7.34,7.407,7.473,7.54,7.54,7.96,8.03,8.1,8.17,8.24,8.24,8.29,8.34,8.39,8.44,8.44,8.58,8.613,8.647,8.68,8.68,8.74,8.8,8.86,8.86,8.922,8.984,9.046,9.108,9.17,9.232,9.294,9.356,9.418,9.48,9.48,9.533,9.585,9.638,9.691,9.744,9.796,9.849,9.902,9.955,10.007,10.06,10.06,10.135,10.21,10.285,10.36,10.36,10.58,10.58,10.629,10.677,10.726,10.774,10.823,10.871,10.92,10.92,10.988,11.056,11.124,11.192,11.26,11.26,11.364,11.468,11.572,11.676,11.78,11.78,12.04,12.053,12.067,12.08,12.08,12.193,12.307,12.42,12.42,12.54,12.54,12.576,12.612,12.648,12.684,12.72,12.72,12.793,12.865,12.938,13.01,13.083,13.155,13.228,13.3,13.3,13.385,13.47,13.555,13.64,13.725,13.81,13.895,13.98,13.98,14.04,14.1,14.16,14.22,14.28,14.34,14.4,14.46,14.46,14.54,14.62,14.7,14.78,14.78,14.837,14.893,14.95,15.007,15.063,15.12,15.12,15.42,15.42,15.495,15.57,15.645,15.72,15.795,15.87,15.945,16.02,16.02,16.32,16.373,16.425,16.478,16.531,16.584,16.636,16.689,16.742,16.795,16.847,16.9,16.9,16.972,17.044,17.116,17.188,17.26,17.26,17.34,17.42,17.5,17.58,17.66,17.723,17.787,17.85,17.913,17.