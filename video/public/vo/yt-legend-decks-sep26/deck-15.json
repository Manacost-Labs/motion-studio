{"source":"chunk-1","from":0,"text":"Пятнадцатое место — ОТК Чернокнижник. К анонсу дополнения «Власть Тёмной Империи» в игру добавили предрелизную легендарку МАТРИАРХ. Всю неделю с ней экспериментировали — и одна колода всё-таки пробилась наверх. Комбинация состоит всего из двух карт: Земляной дракон и Маска нетопыря. Семь драконов на столе — и в конце хода сопернику прилетает двадцать восемь урона. А если поставить ещё и Хронолорда Дейоса — уже сорок восемь. Так зачем тут МАТРИАРХ? Она позволяет разыграть всё это за один ход: удешевляет выбранную карту на пять, две соседние — на четыре, следующие — на три, и так далее.","start":[0,0.06,0.12,0.18,0.24,0.3,0.36,0.42,0.48,0.54,0.6,0.66,0.66,0.712,0.764,0.816,0.868,0.92,0.92,0.92,1.42,1.613,1.807,2,2.36,2.435,2.51,2.585,2.66,2.735,2.81,2.885,2.96,3.035,3.11,3.185,3.26,3.26,3.26,3.72,3.72,3.793,3.867,3.94,4.013,4.087,4.16,4.16,4.216,4.272,4.328,4.384,4.44,4.496,4.552,4.608,4.664,4.72,4.72,4.72,4.8,4.88,4.96,5.04,5.12,5.2,5.2,5.263,5.327,5.39,5.453,5.517,5.58,5.58,5.677,5.774,5.871,5.969,6.066,6.163,6.26,6.26,6.26,6.34,6.34,6.39,6.44,6.49,6.54,6.54,6.593,6.645,6.698,6.75,6.803,6.855,6.908,6.96,6.96,7.018,7.077,7.135,7.193,7.252,7.31,7.368,7.427,7.485,7.543,7.602,7.66,7.66,7.726,7.792,7.858,7.924,7.99,8.056,8.122,8.188,8.254,8.32,8.32,8.428,8.535,8.643,8.75,8.858,8.965,9.073,9.18,9.18,9.18,9.28,9.38,9.48,9.48,9.537,9.593,9.65,9.707,9.763,9.82,9.82,10,10,10.027,10.053,10.08,10.08,10.127,10.173,10.22,10.267,10.313,10.36,10.407,10.453,10.5,10.547,10.593,10.64,10.687,10.733,10.78,10.827,10.873,10.92,10.92,10.92,11.2,11.3,11.3,11.365,11.43,11.495,11.56,11.56,11.627,11.693,11.76,11.827,11.893,11.96,11.96,12.025,12.09,12.155,12.22,12.285,12.35,12.415,12.48,12.48,12.536,12.591,12.647,12.702,12.758,12.813,12.869,12.924,12.98,12.98,13.07,13.16,13.25,13.34,13.43,13.52,13.52,13.7,13.752,13.804,13.856,13.908,13.96,14.012,14.064,14.116,14.168,14.22,14.22,14.283,14.346,14.409,14.471,14.534,14.597,14.66,14.66,14.724,14.788,14.852,14.916