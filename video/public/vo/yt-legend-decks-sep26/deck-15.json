{"source":"chunk-1","from":11.55,"text":"Пятнадцатое место — ОТК Чернокнижник! К анонсу дополнения «Власть Тёмной Империи» в игру добавили предрелизную легендарку МАТРИАРХ. Всю неделю с ней экспериментировали — и одна колода всё-таки пробилась наверх. Комбинация состоит всего из двух карт: Земляной дракон и Маска нетопыря. Семь драконов на столе — и в конце хода сопернику прилетает двадцать восемь урона! А если поставить ещё и Хронолорда Дейоса — уже сорок восемь. Так зачем тут МАТРИАРХ? Она позволяет разыграть всё это за один ход: удешевляет выбранную карту на пять, две соседние — на четыре, следующие — на три, и так далее.","start":[0,0.078,0.156,0.235,0.313,0.391,0.469,0.547,0.625,0.704,0.782,0.86,0.86,0.908,0.956,1.004,1.052,1.1,1.1,1.1,1.1,1.413,1.727,2.04,2.04,2.123,2.207,2.29,2.373,2.457,2.54,2.623,2.707,2.79,2.873,2.957,3.04,3.04,3.04,3.196,3.196,3.286,3.377,3.468,3.559,3.649,3.74,3.74,3.792,3.844,3.896,3.948,4,4.052,4.104,4.156,4.208,4.26,4.26,4.26,4.327,4.393,4.46,4.527,4.593,4.66,4.74,4.777,4.813,4.85,4.887,4.923,4.96,5,5.06,5.12,5.18,5.24,5.3,5.36,5.42,5.42,5.42,5.68,5.68,5.73,5.78,5.83,5.88,5.88,5.933,5.985,6.038,6.09,6.143,6.195,6.248,6.3,6.3,6.357,6.413,6.47,6.527,6.583,6.64,6.697,6.753,6.81,6.867,6.923,6.98,6.98,7.04,7.1,7.16,7.22,7.28,7.34,7.4,7.46,7.52,7.58,7.58,7.665,7.75,7.835,7.92,8.005,8.09,8.175,8.26,8.26,8.26,8.42,8.58,8.74,8.74,8.803,8.867,8.93,8.993,9.057,9.12,9.12,9.3,9.3,9.32,9.34,9.36,9.36,9.409,9.458,9.507,9.556,9.604,9.653,9.702,9.751,9.8,9.849,9.898,9.947,9.996,10.044,10.093,10.142,10.191,10.24,10.24,10.24,10.36,10.56,10.56,10.625,10.69,10.755,10.82,10.82,10.893,10.967,11.04,11.113,11.187,11.26,11.26,11.328,11.395,11.463,11.53,11.598,11.665,11.733,11.8,11.8,11.856,11.911,11.967,12.022,12.078,12.133,12.189,12.244,12.3,12.3,12.377,12.453,12.53,12.607,12.683,12.76,12.76,12.76,12.842,12.924,13.006,13.088,13.17,13.252,13.334,13.416,13.498,13.58,13.58,13.643,13.706,13.769,13.831,13.894,13.957,14.02,14.02,14.072,14.124,14.176,14.228,14.28,14