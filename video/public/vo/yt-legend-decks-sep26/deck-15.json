{"source":"chunk-1","from":11.372,"text":"Пятнадцатое место — ОТК Чернокнижник. К анонсу дополнения «Власть Тёмной Империи» в игру добавили предрелизную легендарку МАТРИАРХ. Всю неделю с ней экспериментировали, и одна из колод всё-таки пробилась наверх. Комбинация состоит всего из двух карт: Земляной дракон и Маска нетопыря. Семь драконов на столе наносят в конце хода двадцать восемь урона, а если поставить Хронолорда Дейоса — сорок восемь. МАТРИАРХ нужна, чтобы разыграть всё это за один ход: она удешевляет выбранную карту на пять, две соседние — на четыре, следующие — на три, и так далее.","start":[0,0.069,0.138,0.207,0.276,0.345,0.415,0.484,0.553,0.622,0.691,0.76,0.76,0.808,0.856,0.904,0.952,1,1,1,1,1.433,1.867,2.3,2.3,2.368,2.437,2.505,2.573,2.642,2.71,2.778,2.847,2.915,2.983,3.052,3.12,3.12,3.12,3.12,3.12,3.27,3.42,3.57,3.72,3.87,4.02,4.02,4.084,4.148,4.212,4.276,4.34,4.404,4.468,4.532,4.596,4.66,4.66,4.66,4.743,4.827,4.91,4.993,5.077,5.16,5.26,5.313,5.367,5.42,5.473,5.527,5.58,5.64,5.706,5.771,5.837,5.903,5.969,6.034,6.1,6.1,6.1,6.38,6.38,6.43,6.48,6.53,6.58,6.58,6.638,6.695,6.753,6.81,6.868,6.925,6.983,7.04,7.04,7.102,7.163,7.225,7.287,7.348,7.41,7.472,7.533,7.595,7.657,7.718,7.78,7.78,7.85,7.92,7.99,8.06,8.13,8.2,8.27,8.34,8.41,8.48,8.48,8.598,8.715,8.833,8.95,9.068,9.185,9.303,9.42,9.42,9.52,9.6,9.68,9.76,9.76,9.827,9.893,9.96,10.027,10.093,10.16,10.16,10.32,10.32,10.347,10.373,10.4,10.4,10.452,10.504,10.557,10.609,10.661,10.713,10.766,10.818,10.87,10.922,10.974,11.027,11.079,11.131,11.183,11.236,11.288,11.34,11.34,11.56,11.62,11.62,11.675,11.73,11.785,11.84,11.84,11.93,12.02,12.02,12.084,12.148,12.212,12.276,12.34,12.34,12.403,12.465,12.528,12.59,12.653,12.715,12.778,12.84,12.84,12.898,12.956,13.013,13.071,13.129,13.187,13.244,13.302,13.36,13.36,13.473,13.587,13.7,13.813,13.927,14.04,14.04,14.18,14.24,14.3,14.36,14.42,14.48,14.54,14.6,14.66,14.72,14.78,14.78,14.851,14.923,14.994,15.066,15.137,15.209,15.28,15.28,15.336,15.392,15.448,15.504,15.56,15.56,15.7,1