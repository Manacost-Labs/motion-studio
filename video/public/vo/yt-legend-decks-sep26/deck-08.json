{"source":"chunk-3","from":0,"text":"Восьмое место — Охотник на демонов Бездны. Последние полтора месяца колода была в тени: играть ею играли, но после нерфа больших успехов не было. Зато при нынешней расстановке сил ей очень комфортно — хорошие шансы в любом матч-апе, кроме Воина. Сборка почти не меняется: Ирида Искатель Греха стала её неотъемлемой частью, а ради обычного темпа игроки активно берут Кватсона.","start":[0,0.08,0.16,0.24,0.32,0.4,0.48,0.56,0.56,0.624,0.688,0.752,0.816,0.88,0.88,0.88,1.38,1.463,1.546,1.629,1.711,1.794,1.877,1.96,1.96,2.07,2.18,2.18,2.249,2.317,2.386,2.454,2.523,2.591,2.66,2.66,2.747,2.833,2.92,3.007,3.093,3.18,3.18,3.64,3.696,3.751,3.807,3.862,3.918,3.973,4.029,4.084,4.14,4.14,4.197,4.254,4.311,4.369,4.426,4.483,4.54,4.54,4.62,4.7,4.78,4.86,4.94,5.02,5.02,5.093,5.167,5.24,5.313,5.387,5.46,5.46,5.515,5.57,5.625,5.68,5.68,5.84,5.84,5.905,5.97,6.035,6.1,6.1,6.52,6.587,6.653,6.72,6.787,6.853,6.92,6.92,7.08,7.24,7.24,7.323,7.407,7.49,7.573,7.657,7.74,7.74,7.98,8.06,8.14,8.14,8.208,8.276,8.344,8.412,8.48,8.48,8.576,8.672,8.768,8.864,8.96,8.96,9.017,9.074,9.131,9.189,9.246,9.303,9.36,9.36,9.434,9.509,9.583,9.657,9.731,9.806,9.88,9.88,9.98,10.08,10.08,10.135,10.19,10.245,10.3,10.3,10.58,10.68,10.78,10.88,10.98,10.98,11.04,11.1,11.16,11.16,11.22,11.28,11.34,11.4,11.46,11.52,11.58,11.64,11.64,11.693,11.745,11.798,11.851,11.904,11.956,12.009,12.062,12.115,12.167,12.22,12.22,12.307,12.393,12.48,12.48,12.64,12.8,12.8,12.884,12.968,13.052,13.136,13.22,13.22,13.304,13.389,13.473,13.558,13.642,13.727,13.811,13.896,13.98,13.98,13.98,14.26,14.323,14.386,14.449,14.511,14.574,14.637,14.7,14.7,14.784,14.868,14.952,15.036,15.12,15.12,15.22,15.22,15.28,15.34,15.4,15.46,15.52,15.52,15.593,15.665,15.738,15.81,15.883,15.955,16.028,16.1,16.1,16.24,16.292,16.344,16.396,16.448,16.5,16.5,16.576,16.652,16.728,16.804,16.88,16.88,17.26,17.343,17.427,17.51,17.593,17.677,17.76,17.76,17.816,17.872,17.928,17.984,18.04,18.04,18.16,18.28,18.28,18.34,18.4,18.46,18.52,18.58,1