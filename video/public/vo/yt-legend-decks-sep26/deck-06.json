{"source":"chunk-3","from":56.44,"text":"Шестое место — Зи Шаман. По эффективности он очень похож на Шамана на возвещении, но без доступа к заклинаниям — а значит, и к Сглазу — у него огромный провал против Квест Жреца. Зато многие другие матч-апы, против Друида, Охотника на демонов и Разбойника, он разыгрывает лучше, поэтому и стоит выше. Наверху кривой — Ультраксион, Ал'акир и Смертокрыл.","start":[0,0.103,0.207,0.31,0.413,0.517,0.62,0.62,0.66,0.7,0.74,0.78,0.82,0.82,0.82,1.38,1.56,1.74,1.8,1.876,1.952,2.028,2.104,2.18,2.18,2.54,2.61,2.68,2.68,2.734,2.788,2.842,2.895,2.949,3.003,3.057,3.111,3.165,3.218,3.272,3.326,3.38,3.38,3.51,3.64,3.64,3.716,3.792,3.868,3.944,4.02,4.02,4.08,4.14,4.2,4.26,4.32,4.32,4.46,4.6,4.6,4.67,4.74,4.81,4.88,4.95,5.02,5.02,5.09,5.16,5.16,5.224,5.288,5.352,5.416,5.48,5.544,5.608,5.672,5.736,5.8,5.8,6.08,6.18,6.28,6.28,6.367,6.453,6.54,6.54,6.611,6.683,6.754,6.826,6.897,6.969,7.04,7.04,7.08,7.08,7.149,7.218,7.287,7.356,7.425,7.495,7.564,7.633,7.702,7.771,7.84,7.84,7.84,8.02,8.1,8.1,8.153,8.207,8.26,8.313,8.367,8.42,8.42,8.42,8.7,8.7,8.72,8.72,8.817,8.913,9.01,9.107,9.203,9.3,9.3,9.3,9.48,9.58,9.58,9.63,9.68,9.73,9.78,9.78,9.868,9.955,10.043,10.13,10.218,10.305,10.393,10.48,10.48,10.55,10.62,10.69,10.76,10.83,10.9,10.9,10.957,11.013,11.07,11.127,11.183,11.24,11.24,11.312,11.384,11.456,11.528,11.6,11.7,11.784,11.868,11.952,12.036,12.12,12.12,12.46,12.54,12.62,12.7,12.78,12.78,12.843,12.907,12.97,13.033,13.097,13.16,13.16,13.2,13.24,13.28,13.32,13.36,13.4,13.4,13.495,13.59,13.685,13.78,13.875,13.97,14.065,14.16,14.16,14.36,14.4,14.44,14.48,14.52,14.56,14.6,14.6,14.69,14.78,14.87,14.96,15.05,15.14,15.14,15.34,15.388,15.435,15.483,15.53,15.578,15.625,15.673,15.72,15.72,15.82,15.92,15.92,15.977,16.034,16.091,16.149,16.206,16.263,16.32,16.32,16.52,16.52,16.578,16.636,16.694,16.752,16.81,16.868,16.926,16.984,17.042,17.1,17.1,17.38,17.42,17.46,17.46,17.515,17.569,17.624,17.678,17.733,17.787,17.842,17.896,17.951,18.005,18.06,18.06,18.116,18.172,18.228