{"source":"chunk-1","from":81.098,"text":"Тринадцатое место — Берн Маг. После нерфа Квест Мага у класса осталась, по сути, одна рабочая колода. Недавно игроки пробовали сборки с Аметистовой тревогой, но старые версии показывают себя лучше, и во всех есть Гениальность Хранителя Магии. Берн Маг успешно наказывает Чернокнижников и Разбойников всех мастей.","start":[0,0.064,0.127,0.191,0.255,0.318,0.382,0.445,0.509,0.573,0.636,0.7,0.7,0.744,0.788,0.832,0.876,0.92,0.92,0.92,1.44,1.575,1.71,1.845,1.98,1.98,2.1,2.22,2.34,2.34,2.34,2.5,2.66,2.82,2.98,3.14,3.14,3.236,3.332,3.428,3.524,3.62,3.62,3.684,3.748,3.812,3.876,3.94,3.94,4.07,4.2,4.33,4.46,4.46,4.66,4.66,4.723,4.787,4.85,4.913,4.977,5.04,5.04,5.095,5.15,5.205,5.26,5.315,5.37,5.425,5.48,5.48,5.52,5.58,5.64,5.64,5.725,5.81,5.895,5.98,5.98,6.14,6.205,6.27,6.335,6.4,6.4,6.486,6.571,6.657,6.743,6.829,6.914,7,7,7.073,7.147,7.22,7.293,7.367,7.44,7.44,7.44,7.549,7.657,7.766,7.874,7.983,8.091,8.2,8.2,8.273,8.347,8.42,8.493,8.567,8.64,8.64,8.691,8.742,8.793,8.844,8.896,8.947,8.998,9.049,9.1,9.1,9.177,9.253,9.33,9.407,9.483,9.56,9.56,9.68,9.68,9.731,9.782,9.833,9.884,9.935,9.985,10.036,10.087,10.138,10.189,10.24,10.24,10.318,10.395,10.473,10.55,10.628,10.705,10.782,10.86,10.86,10.94,11.06,11.18,11.18,11.25,11.32,11.39,11.46,11.53,11.6,11.6,11.67,11.74,11.81,11.88,11.95,12.02,12.02,12.084,12.148,12.212,12.276,12.34,12.404,12.468,12.532,12.596,12.66,12.66,12.715,12.77,12.825,12.88,12.88,12.96,13.04,13.12,13.2,13.28,13.28,13.28,13.74,13.74,13.81,13.88,13.88,13.95,14.02,14.09,14.16,14.16,14.255,14.35,14.445,14.54,14.54,14.608,14.677,14.745,14.813,14.882,14.95,15.018,15.087,15.155,15.223,15.292,15.36,15.36,15.42,15.48,15.54,15.6,15.66,15.72,15.78,15.84,15.9,15.9,16,16.1,16.2,16.3,16.4,16.4,16.4,16.58,16.76,16.94,17.12,17.12,17.207,17.293,17.38,17.38,17.474,17.569,17.663,17.757,17.851,17.946,18.04,18.04,18.098,18.156,18.214,18.272,18.33,18.388,18.446,18.504,18.562,18.62,18.62,18.677,18.734,18.791,18.849,18.906,18.963,19.02,19.077,19.1