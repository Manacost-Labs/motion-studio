{"source":"chunk-3","from":81.553,"text":"Пятое место — Граб Шаман. Он ещё больше похож на Шамана на возвещении — в нём тоже два Сглаза. Отличие одно: Шаман на возвещении проигрывает Воину, но побеждает Чернокнижника, а Граб Шаман — наоборот. Воин в текущей мете намного опаснее Чернокнижника, поэтому Граб Шаман оказывается полезнее.","start":[0,0.088,0.176,0.264,0.352,0.44,0.44,0.488,0.536,0.584,0.632,0.68,0.68,0.68,1.26,1.335,1.41,1.485,1.56,1.64,1.716,1.792,1.868,1.944,2.02,2.02,2.4,2.49,2.58,2.58,2.7,2.82,2.94,2.94,3,3.06,3.12,3.18,3.24,3.3,3.3,3.372,3.444,3.516,3.588,3.66,3.66,3.8,3.94,3.94,4.01,4.08,4.15,4.22,4.29,4.36,4.36,4.41,4.46,4.46,4.522,4.584,4.646,4.708,4.77,4.832,4.894,4.956,5.018,5.08,5.08,5.08,5.44,5.54,5.54,5.573,5.607,5.64,5.64,5.73,5.82,5.91,6,6,6.08,6.16,6.24,6.24,6.343,6.447,6.55,6.653,6.757,6.86,6.86,7.1,7.177,7.254,7.331,7.409,7.486,7.563,7.64,7.64,7.72,7.8,7.88,7.96,7.96,8.38,8.464,8.548,8.632,8.716,8.8,8.8,8.84,8.88,8.88,8.944,9.008,9.072,9.136,9.2,9.264,9.328,9.392,9.456,9.52,9.52,9.587,9.655,9.722,9.789,9.856,9.924,9.991,10.058,10.125,10.193,10.26,10.26,10.352,10.444,10.536,10.628,10.72,10.72,10.92,10.97,11.02,11.02,11.084,11.149,11.213,11.278,11.342,11.407,11.471,11.536,11.6,11.6,11.665,11.729,11.794,11.858,11.923,11.988,12.052,12.117,12.182,12.246,12.311,12.375,12.44,12.44,12.74,12.86,12.86,12.94,13.02,13.1,13.18,13.22,13.3,13.38,13.46,13.54,13.62,13.62,13.62,13.66,13.733,13.805,13.878,13.95,14.023,14.095,14.168,14.24,14.24,14.6,14.715,14.83,14.945,15.06,15.06,15.14,15.14,15.206,15.271,15.337,15.403,15.469,15.534,15.6,15.6,15.665,15.73,15.795,15.86,15.86,15.94,16.02,16.1,16.18,16.26,16.34,16.42,16.42,16.509,16.597,16.686,16.774,16.863,16.951,17.04,17.04,17.103,17.166,17.229,17.292,17.355,17.418,17.482,17.545,17.608,17.671,17.734,17.797,17.86,17.86,18.08,18.131,18.183,18.234,18.286,18.337,18.389,18.44,18.44,18.535,18.63,18.725,18.82,18.84,18.916,18.992,19.068,19.144,19.22,19.22,19.285,19.351,19.416,19.482,19.547,19.613,19.678,19.744,19.8