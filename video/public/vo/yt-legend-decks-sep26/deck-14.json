{"source":"chunk-1","from":50.212,"text":"Четырнадцатое место — Квест Жрец. С выходом классовых наборов квест «Достичь равновесия» перестал быть просто активатором Триумфа Медива — теперь это полноценный способ победы! Награду за квест копирует Эксперт по духам, перепризывает Скользкая смерть и воскрешает Хлад ван Пир. А новые карты отлично сочетаются с Гадалкой. Сейчас это одна из самых популярных колод меты. Матч-апы у неё непростые, зато против лидера меты, Дракон Воина, у Жреца хорошие шансы!","start":[0.21,0.237,0.264,0.291,0.318,0.345,0.372,0.398,0.425,0.452,0.479,0.506,0.533,0.56,0.56,0.652,0.744,0.836,0.928,1.02,1.02,1.02,1.54,1.608,1.676,1.744,1.812,1.88,2.04,2.135,2.23,2.325,2.42,2.42,2.42,2.9,2.9,2.954,3.009,3.063,3.117,3.171,3.226,3.28,3.28,3.327,3.373,3.42,3.467,3.513,3.56,3.607,3.653,3.7,3.7,3.757,3.814,3.871,3.929,3.986,4.043,4.1,4.4,4.452,4.504,4.556,4.608,4.66,4.66,4.76,4.817,4.874,4.931,4.989,5.046,5.103,5.16,5.2,5.254,5.308,5.362,5.416,5.47,5.524,5.578,5.632,5.686,5.74,5.74,5.74,5.81,5.88,5.95,6.02,6.09,6.16,6.23,6.3,6.3,6.345,6.39,6.435,6.48,6.48,6.52,6.56,6.6,6.64,6.68,6.72,6.72,6.782,6.844,6.905,6.967,7.029,7.091,7.153,7.215,7.276,7.338,7.4,7.4,7.457,7.514,7.571,7.629,7.686,7.743,7.8,7.8,7.877,7.953,8.03,8.107,8.183,8.26,8.26,8.26,8.38,8.443,8.507,8.57,8.633,8.697,8.76,8.76,8.9,9.04,9.18,9.18,9.26,9.34,9.42,9.5,9.58,9.66,9.74,9.82,9.9,9.98,10.06,10.06,10.103,10.147,10.19,10.233,10.277,10.32,10.32,10.437,10.553,10.67,10.787,10.903,11.02,11.02,11.3,11.357,11.414,11.471,11.529,11.586,11.643,11.7,11.7,11.75,11.8,11.8,11.86,11.92,11.98,12.04,12.1,12.1,12.163,12.225,12.288,12.35,12.413,12.475,12.538,12.6,12.6,12.663,12.726,12.789,12.851,12.914,12.977,13.04,13.04,13.12,13.2,13.2,13.272,13.344,13.416,13.488,13.56,13.56,13.74,13.78,13.82,13.86,13.9,13.94,13.98,14.02,14.06,14.1,14.14,14.18,14.22,14.26,14.26,14.322,14.384,14.447,14.509,14.571,14.633,14.696,14.758,14.82,14.82,14.9,14.98,15.06,15.14,15.22,15.3,15.3,15.44,15.44,15.506,15.572,15.638,15.704,15