{"source":"chunk-1","from":40.246,"text":"Четырнадцатое место — Квест Жрец. С выходом классовых наборов квест «Достичь равновесия» перестал быть просто активатором Триумфа Медива — теперь это полноценный способ победы. Награду за квест копирует Эксперт по духам, перепризывает Скользкая смерть и воскрешает Хлад ван Пир. А новые карты отлично сочетаются с Гадалкой. Сейчас это одна из самых популярных колод меты. Матч-апы у неё непростые, зато против лидера меты, Дракон Воина, у Жреца хорошие шансы.","start":[0.25,0.277,0.304,0.331,0.358,0.385,0.412,0.438,0.465,0.492,0.519,0.546,0.573,0.6,0.6,0.684,0.768,0.852,0.936,1.02,1.02,1.02,1.6,1.668,1.736,1.804,1.872,1.94,2.16,2.25,2.34,2.43,2.52,2.52,3,3.08,3.08,3.134,3.189,3.243,3.297,3.351,3.406,3.46,3.46,3.513,3.567,3.62,3.673,3.727,3.78,3.833,3.887,3.94,3.94,3.997,4.054,4.111,4.169,4.226,4.283,4.34,4.68,4.728,4.776,4.824,4.872,4.92,4.92,5.08,5.137,5.194,5.251,5.309,5.366,5.423,5.48,5.52,5.576,5.632,5.688,5.744,5.8,5.856,5.912,5.968,6.024,6.08,6.08,6.26,6.303,6.345,6.387,6.43,6.473,6.515,6.557,6.6,6.6,6.65,6.7,6.75,6.8,6.8,6.84,6.88,6.92,6.96,7,7.04,7.04,7.104,7.167,7.231,7.295,7.358,7.422,7.485,7.549,7.613,7.676,7.74,7.74,7.806,7.871,7.937,8.003,8.069,8.134,8.2,8.2,8.27,8.34,8.41,8.48,8.55,8.62,8.62,8.62,8.8,8.847,8.893,8.94,8.987,9.033,9.08,9.08,9.207,9.333,9.46,9.46,9.538,9.616,9.695,9.773,9.851,9.929,10.007,10.085,10.164,10.242,10.32,10.32,10.367,10.413,10.46,10.507,10.553,10.6,10.6,10.71,10.82,10.93,11.04,11.15,11.26,11.26,11.52,11.577,11.634,11.691,11.749,11.806,11.863,11.92,11.92,11.98,12.04,12.04,12.1,12.16,12.22,12.28,12.34,12.34,12.408,12.475,12.543,12.61,12.678,12.745,12.813,12.88,12.88,12.943,13.006,13.069,13.131,13.194,13.257,13.32,13.32,13.42,13.52,13.52,13.588,13.656,13.724,13.792,13.86,13.86,14.06,14.102,14.143,14.185,14.226,14.268,14.309,14.351,14.392,14.434,14.475,14.517,14.558,14.6,14.6,14.664,14.729,14.793,14.858,14.922,14.987,15.051,15.116,15.18,15.18,15.26,15.34,15.42,15.5,15.58,15.66,15.66,15.82,15.82