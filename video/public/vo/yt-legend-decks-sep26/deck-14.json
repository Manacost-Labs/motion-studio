{"source":"chunk-1","from":48.505,"text":"Четырнадцатое место — Квест Жрец. С выходом классовых наборов квест «Достичь равновесия» перестал быть активатором Триумфа Медива и превратился в полноценный способ победы. Награду за квест теперь копирует Эксперт по духам, перепризывает Скользкая смерть и воскрешает Хлад ван Пир, а новые карты отлично сочетаются с Гадалкой. Сейчас это одна из самых популярных колод меты: матч-апы у неё непростые, зато против лидера меты, Дракон Воина, у Жреца хорошие шансы.","start":[0.19,0.217,0.244,0.271,0.298,0.325,0.352,0.378,0.405,0.432,0.459,0.486,0.513,0.54,0.54,0.644,0.748,0.852,0.956,1.06,1.06,1.06,1.66,1.732,1.804,1.876,1.948,2.02,2.28,2.375,2.47,2.565,2.66,2.66,3.2,3.34,3.34,3.394,3.449,3.503,3.557,3.611,3.666,3.72,3.72,3.778,3.836,3.893,3.951,4.009,4.067,4.124,4.182,4.24,4.24,4.3,4.36,4.42,4.48,4.54,4.6,4.66,4.96,5.028,5.096,5.164,5.232,5.3,5.3,5.44,5.506,5.571,5.637,5.703,5.769,5.834,5.9,5.92,5.98,6.04,6.1,6.16,6.22,6.28,6.34,6.4,6.46,6.52,6.52,6.8,6.85,6.9,6.95,7,7.05,7.1,7.15,7.2,7.2,7.25,7.3,7.35,7.4,7.4,7.455,7.509,7.564,7.618,7.673,7.727,7.782,7.836,7.891,7.945,8,8,8.063,8.126,8.189,8.251,8.314,8.377,8.44,8.44,8.527,8.613,8.7,8.787,8.873,8.96,8.96,9.14,9.14,9.193,9.245,9.298,9.351,9.404,9.456,9.509,9.562,9.615,9.667,9.72,9.72,9.92,9.92,9.989,10.058,10.127,10.196,10.265,10.335,10.404,10.473,10.542,10.611,10.68,10.68,10.727,10.773,10.82,10.867,10.913,10.96,10.96,11.08,11.2,11.32,11.44,11.56,11.68,11.68,12,12.066,12.131,12.197,12.263,12.329,12.394,12.46,12.46,12.52,12.58,12.58,12.648,12.716,12.784,12.852,12.92,12.92,12.977,13.033,13.09,13.147,13.203,13.26,13.26,13.335,13.41,13.485,13.56,13.635,13.71,13.785,13.86,13.86,13.931,14.003,14.074,14.146,14.217,14.289,14.36,14.36,14.47,14.58,14.58,14.652,14.724,14.796,14.868,14.94,14.94,15.2,15.245,15.289,15.334,15.378,15.423,15.468,15.512,15.557,15.602,15.646,15.691,15.735,15.78,15.78,15.849,15.918,15.987,16.056,16.124,16.193,16.262,16.331,16.4,16.4,16.483,16.567,16.65,16.733,16.817,