{"source":"chunk-2","from":72.434,"text":"Десятое место — Кхелос Рыцарь смерти. Победитель Чемпионата мира показал всем, как правильно играть этой колодой, и дела архетипа пошли в гору. Ключевая карта здесь — Костоправ: он позволяет выходить сухим из воды в самых сложных ситуациях. Очень важно подготовить его до нуля или одной маны — тогда в трудный момент Рыцарь смерти потратит намного больше маны, чем у него есть, и найдёт ответы на угрозы соперника. Кхелос ДК хорошо справляется со всеми Воинами и с невероятно популярным Квест Жрецом.","start":[0,0.103,0.206,0.309,0.411,0.514,0.617,0.72,0.72,0.772,0.824,0.876,0.928,0.98,0.98,0.98,1.48,1.56,1.64,1.72,1.8,1.88,1.96,2.22,2.287,2.353,2.42,2.487,2.553,2.62,2.7,2.763,2.827,2.89,2.953,3.017,3.08,3.08,3.48,3.526,3.572,3.618,3.664,3.71,3.756,3.802,3.848,3.894,3.94,3.94,4,4.06,4.12,4.18,4.24,4.3,4.36,4.42,4.48,4.54,4.54,4.615,4.69,4.765,4.84,4.84,4.926,5.011,5.097,5.183,5.269,5.354,5.44,5.44,5.495,5.55,5.605,5.66,5.66,5.92,5.96,6,6.04,6.04,6.098,6.156,6.213,6.271,6.329,6.387,6.444,6.502,6.56,6.56,6.63,6.7,6.77,6.84,6.91,6.98,6.98,7.045,7.11,7.175,7.24,7.24,7.314,7.389,7.463,7.537,7.611,7.686,7.76,7.76,7.76,8.02,8.02,8.065,8.11,8.155,8.2,8.2,8.285,8.37,8.455,8.54,8.625,8.71,8.795,8.88,8.88,8.96,9.04,9.12,9.2,9.28,9.28,9.4,9.4,9.475,9.55,9.625,9.7,9.7,10.02,10.078,10.135,10.192,10.25,10.308,10.365,10.423,10.48,10.48,10.556,10.632,10.708,10.784,10.86,10.86,10.928,10.996,11.064,11.132,11.2,11.2,11.2,11.42,11.476,11.531,11.587,11.642,11.698,11.753,11.809,11.864,11.92,11.92,12.32,12.39,12.46,12.46,12.513,12.567,12.62,12.673,12.727,12.78,12.833,12.887,12.94,12.94,12.997,13.055,13.113,13.17,13.228,13.285,13.343,13.4,13.4,13.476,13.552,13.628,13.704,13.78,13.78,13.85,13.92,13.92,13.975,14.03,14.085,14.14,14.14,14.34,14.34,14.408,14.476,14.544,14.612,14.68,14.68,14.754,14.829,14.903,14.977,15.051,15.126,15.2,15.2,15.282,15.364,15.447,15.529,15.611,15.693,15.776,15.858,15.94,15.94,16.18,16.244,16.308,16.372,16.436,16.5,16.5,16.568,16.