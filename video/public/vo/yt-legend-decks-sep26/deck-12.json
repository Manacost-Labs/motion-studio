{"source":"chunk-2","from":0,"text":"Двенадцатое место — Чернокнижник на возвещении. Крестный отец Казакус из классового набора помог всему классу: карта очень гибкая и очень сильная по кривой маны. Одно из лучших её применений — на четвёртом ходу собрать большой стол из трёх трёхдропов и усилить его массовым баффом. Своего гиганта колода по-прежнему не берёт: большие угрозы она намного лучше призывает другими картами. А одна из сильнейших карт класса сейчас — Проклятые цепи, особенно против Жрецов, которых в ладдере очень много. Колода очень хорошая, но матч-апы с Воинами заметно снижают её эффективность.","start":[0,0.073,0.145,0.218,0.291,0.364,0.436,0.509,0.582,0.655,0.727,0.8,0.8,0.852,0.904,0.956,1.008,1.06,1.06,1.06,1.72,1.78,1.84,1.9,1.96,2.02,2.08,2.14,2.2,2.26,2.32,2.38,2.44,2.44,2.59,2.74,2.74,2.81,2.88,2.95,3.02,3.09,3.16,3.23,3.3,3.37,3.44,3.44,4.02,4.068,4.115,4.163,4.21,4.258,4.305,4.353,4.4,4.4,4.465,4.53,4.595,4.66,4.66,4.751,4.843,4.934,5.026,5.117,5.209,5.3,5.3,5.41,5.52,5.52,5.58,5.64,5.7,5.76,5.82,5.88,5.94,6,6.06,6.12,6.12,6.18,6.24,6.3,6.36,6.42,6.48,6.48,6.56,6.64,6.72,6.8,6.88,6.88,6.964,7.048,7.132,7.216,7.3,7.3,7.387,7.473,7.56,7.647,7.733,7.82,7.82,8.12,8.184,8.248,8.312,8.376,8.44,8.44,8.512,8.584,8.656,8.728,8.8,8.8,8.893,8.987,9.08,9.173,9.267,9.36,9.36,9.64,9.64,9.72,9.8,9.88,9.96,10.04,10.04,10.114,10.189,10.263,10.337,10.411,10.486,10.56,10.56,10.56,10.56,10.56,10.637,10.713,10.79,10.867,10.943,11.02,11.02,11.095,11.17,11.245,11.32,11.32,11.68,11.75,11.82,11.89,11.96,11.96,12.04,12.12,12.12,12.173,12.227,12.28,12.333,12.387,12.44,12.44,12.56,12.68,12.68,12.738,12.796,12.854,12.912,12.97,13.028,13.086,13.144,13.202,13.26,13.26,13.26,13.56,13.62,13.68,13.68,13.729,13.778,13.827,13.876,13.924,13.973,14.022,14.071,14.12,14.12,14.21,14.3,14.39,14.48,14.48,14.529,14.577,14.626,14.674,14.723,14.771,14.82,14.82,14.889,14.957,15.026,15.094,15.163,15.231,15.3,15.3,15.38,15.46,15.54,15.62,15.62,15.75,15.88,15.88,15.957,16.033,16.11,16.186,16.1