{"source":"chunk-2","from":39.239,"text":"Одиннадцатое место — Стелс Разбойник на возвещении. В классовом наборе Валиры появились очень сильные карты, особенно Матиас Шоу и Истребитель из ШРУ. Чтобы правильно их реализовать, старайтесь не выводить из маскировки более мелкие угрозы. С новыми картами колода регулярно наваливается на соперника снежным комом и побеждает задолго до своих больших угроз — это эффективнее сборок, где есть только Шоу. Архетип очень уверенный, но, как и Чернокнижник на возвещении, страдает от Воинов.","start":[0,0.067,0.133,0.2,0.267,0.333,0.4,0.467,0.533,0.6,0.667,0.733,0.8,0.8,0.852,0.904,0.956,1.008,1.06,1.06,1.06,1.46,1.564,1.668,1.772,1.876,1.98,2.06,2.127,2.193,2.26,2.327,2.393,2.46,2.527,2.593,2.66,2.82,2.85,2.88,2.88,2.948,3.016,3.084,3.152,3.22,3.288,3.356,3.424,3.492,3.56,3.56,4.1,4.12,4.12,4.176,4.231,4.287,4.342,4.398,4.453,4.509,4.564,4.62,4.62,4.673,4.727,4.78,4.833,4.887,4.94,4.94,5.013,5.087,5.16,5.233,5.307,5.38,5.38,5.44,5.5,5.56,5.62,5.68,5.74,5.8,5.86,5.92,5.92,6.008,6.096,6.184,6.272,6.36,6.36,6.434,6.509,6.583,6.657,6.731,6.806,6.88,6.88,6.972,7.064,7.156,7.248,7.34,7.34,7.6,7.66,7.72,7.78,7.84,7.9,7.96,8.02,8.08,8.08,8.203,8.327,8.45,8.573,8.697,8.82,8.82,8.967,9.113,9.26,9.26,9.48,9.48,9.542,9.604,9.665,9.727,9.789,9.851,9.913,9.975,10.036,10.098,10.16,10.16,10.29,10.42,10.42,10.507,10.593,10.68,10.68,11,11.044,11.088,11.132,11.176,11.22,11.22,11.276,11.331,11.387,11.442,11.498,11.553,11.609,11.664,11.72,11.72,11.83,11.94,11.94,11.989,12.038,12.087,12.136,12.185,12.235,12.284,12.333,12.382,12.431,12.48,12.48,12.86,12.894,12.928,12.962,12.996,13.03,13.064,13.098,13.132,13.166,13.2,13.2,13.33,13.46,13.46,13.51,13.56,13.61,13.66,13.71,13.76,13.81,13.86,13.86,13.95,14.04,14.04,14.102,14.164,14.226,14.288,14.35,14.412,14.474,14.536,14.598,14.66,14.66,14.728,14.796,14.864,14.932,15,15,15.08,15.16,15.24,15.32,15.4,15.48,15.48,15.573,15.667,15.76,15.853,15.947,16.04,16.04,16.32,16.44,16.44,16.497,16.553,16.61,16.667,16.723,16.