{"source":"chunk-3","from":103.236,"text":"Четвёртое место — Рыцарь смерти Нечестивости. В текущей мете он способен победить и Дракон Воина, и Пират Воина, а остальной разброс матч-апов у него очень неплохой — колода актуальна даже среди топовых игроков. Её слабые места — Жрецы и Охотник на демонов Бездны. Как и у Кхелос ДК, здесь есть Костоправ, а из легендарок — Фалрик и Посох Вестницы гибели.","start":[0,0.076,0.151,0.227,0.302,0.378,0.453,0.529,0.604,0.68,0.68,0.72,0.76,0.8,0.84,0.88,0.88,0.88,1.52,1.593,1.667,1.74,1.813,1.887,1.96,1.96,2.03,2.1,2.17,2.24,2.31,2.38,2.38,2.448,2.517,2.585,2.653,2.722,2.79,2.858,2.927,2.995,3.063,3.132,3.2,3.2,3.64,3.7,3.7,3.766,3.831,3.897,3.963,4.029,4.094,4.16,4.16,4.23,4.3,4.37,4.44,4.44,4.55,4.66,4.66,4.725,4.79,4.855,4.92,4.985,5.05,5.115,5.18,5.18,5.248,5.315,5.382,5.45,5.518,5.585,5.653,5.72,5.72,5.86,5.86,5.933,6.007,6.08,6.153,6.227,6.3,6.32,6.396,6.472,6.548,6.624,6.7,6.7,6.7,6.96,6.96,7.04,7.12,7.2,7.28,7.36,7.46,7.524,7.588,7.652,7.716,7.78,7.78,8.08,8.18,8.18,8.227,8.273,8.32,8.367,8.413,8.46,8.507,8.553,8.6,8.6,8.651,8.703,8.754,8.806,8.857,8.909,8.96,8.96,9.027,9.093,9.16,9.227,9.293,9.36,9.427,9.493,9.56,9.56,9.7,9.7,9.745,9.79,9.835,9.88,9.88,9.956,10.032,10.108,10.184,10.26,10.26,10.343,10.425,10.508,10.59,10.673,10.755,10.838,10.92,10.92,10.92,11.14,11.203,11.267,11.33,11.393,11.457,11.52,11.52,11.587,11.653,11.72,11.787,11.853,11.92,11.987,12.053,12.12,12.12,12.195,12.27,12.345,12.42,12.42,12.508,12.596,12.684,12.772,12.86,12.86,12.92,12.98,13.04,13.1,13.16,13.22,13.28,13.28,13.363,13.446,13.529,13.611,13.694,13.777,13.86,13.86,14.18,14.3,14.42,14.42,14.49,14.56,14.63,14.7,14.77,14.84,14.84,14.884,14.928,14.972,15.016,15.06,15.06,15.06,15.48,15.584,15.688,15.792,15.896,16,16,16.24,16.24,16.314,16.389,16.463,16.537,16.611,16.686,16.76,16.76,16.85,16.94,16.94,16.997,17.054,17.111,17.169,17.226,17.283,17.34,17.34,17.417,17.493,17.57,17.647,17.723,17.8,17.8,18.12,18.173,18.227,18.28,18.28,18.42,18.42,18.5,18.5,18.