{"source":"chunk-3","from":27.336,"text":"Седьмое место — Чистый Паладин. С него начинается блок колод, которыми почти никто не играет: у них слишком простой геймплей, или их понерфили. Даже хорошая статистика на пути к Легенде не спасает их от низкого плейрейта. У Чистого Паладина относительно ровный разброс матч-апов и важное преимущество над Друидом на атаке — самой популярной колодой меты. Из легендарок в колоде — Командир Беатриса, Ноздорму и Гелбин из будущего.","start":[0.28,0.323,0.366,0.409,0.451,0.494,0.537,0.58,0.58,0.644,0.708,0.772,0.836,0.9,0.9,0.9,1.42,1.483,1.547,1.61,1.673,1.737,1.8,1.8,1.88,1.96,2.04,2.12,2.2,2.28,2.36,2.36,2.76,2.94,2.94,2.975,3.01,3.045,3.08,3.08,3.14,3.2,3.26,3.32,3.38,3.44,3.5,3.56,3.62,3.68,3.68,3.745,3.81,3.875,3.94,3.94,4.024,4.108,4.192,4.276,4.36,4.36,4.46,4.513,4.565,4.618,4.67,4.723,4.775,4.828,4.88,4.88,4.956,5.032,5.108,5.184,5.26,5.26,5.344,5.428,5.512,5.596,5.68,5.68,5.78,5.88,5.88,5.957,6.033,6.11,6.187,6.263,6.34,6.34,6.58,6.74,6.74,6.78,6.82,6.86,6.86,6.909,6.957,7.006,7.054,7.103,7.151,7.2,7.2,7.274,7.349,7.423,7.497,7.571,7.646,7.72,7.72,7.785,7.85,7.915,7.98,8.045,8.11,8.175,8.24,8.24,8.24,8.387,8.533,8.68,8.68,8.81,8.94,8.94,9.002,9.064,9.127,9.189,9.251,9.313,9.376,9.438,9.5,9.5,9.82,9.89,9.96,10.03,10.1,10.1,10.183,10.266,10.349,10.431,10.514,10.597,10.68,10.68,10.74,10.8,10.86,10.92,10.98,11.04,11.1,11.16,11.22,11.28,11.28,11.34,11.4,11.4,11.46,11.52,11.58,11.64,11.64,11.74,11.74,11.8,11.86,11.92,11.98,12.04,12.1,12.16,12.16,12.31,12.46,12.46,12.537,12.614,12.691,12.769,12.846,12.923,13,13,13.09,13.18,13.18,13.3,13.42,13.42,13.477,13.534,13.591,13.649,13.706,13.763,13.82,13.82,13.887,13.953,14.02,14.087,14.153,14.22,14.287,14.353,14.42,14.42,14.78,14.92,14.92,14.969,15.017,15.066,15.114,15.163,15.211,15.26,15.26,15.32,15.38,15.44,15.5,15.56,15.62,15.68,15.74,15.74,15.798,15.857,15.915,15.973,16.032,16.09,16.148,16.207,16.265,16.323,16.382,16.44,16.44,16.523,16.607,16.69,16.773,16.857,16.94,16.94,16.991,17.0