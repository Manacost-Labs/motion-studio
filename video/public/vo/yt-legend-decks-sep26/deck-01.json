{"source":"chunk-4","from":66.602,"text":"И первое место — Дракон Воин. Игрокам понадобилось время, чтобы понять: дешёвые карты Пират Воина сильны даже в вакууме, без дополнительных синергий. А раз у Гарроша есть ещё одна агро колода, почему бы не положить их и туда? Так появился, как его часто называют, Дракон Пират Воин. Одна из главных ошибок — брать вместе с дешёвыми пиратами ещё и Дария Краули: Дракон Воину он совершенно не нужен и делает колоду слабее. Драконы держат стол гораздо увереннее пиратов, а это залог успеха против Друида, которому тяжело бороться за стол в начале партии. Друид намного популярнее Воина, поэтому этот матч-ап критически важен. Именно поэтому лидер меты — Дракон Воин, а не Пират Воин. И напоследок: Воинов побеждают Кхелос ДК, ДК Нечестивости и Граб Шаман.","start":[0,0.24,0.24,0.327,0.413,0.5,0.587,0.673,0.76,0.76,0.828,0.896,0.964,1.032,1.1,1.1,1.1,1.8,1.893,1.987,2.08,2.173,2.267,2.36,2.48,2.605,2.73,2.855,2.98,2.98,3.5,3.566,3.631,3.697,3.763,3.829,3.894,3.96,3.96,4.007,4.053,4.1,4.147,4.193,4.24,4.287,4.333,4.38,4.427,4.473,4.52,4.52,4.592,4.664,4.736,4.808,4.88,4.88,4.98,5.02,5.06,5.1,5.14,5.18,5.18,5.25,5.32,5.39,5.46,5.53,5.6,5.6,6.02,6.08,6.14,6.2,6.26,6.32,6.38,6.44,6.44,6.516,6.592,6.668,6.744,6.82,6.82,6.88,6.94,7,7.06,7.12,7.18,7.248,7.316,7.384,7.452,7.52,7.7,7.753,7.807,7.86,7.913,7.967,8.02,8.02,8.095,8.17,8.245,8.32,8.32,8.52,8.52,8.603,8.686,8.769,8.851,8.934,9.017,9.1,9.1,9.18,9.28,9.38,9.48,9.48,9.529,9.577,9.626,9.674,9.723,9.771,9.82,9.869,9.917,9.966,10.014,10.063,10.111,10.16,10.16,10.23,10.3,10.37,10.44,10.51,10.58,10.65,10.72,10.72,11.06,11.18,11.18,11.22,11.26,11.3,11.3,11.44,11.44,11.5,11.56,11.62,11.68,11.74,11.8,11.86,11.86,11.92,11.98,12.04,12.1,12.1,12.22,12.34,12.46,12.46,12.545,12.63,12.715,12.8,12.8,12.99,13.18,13.37,13.56,13.56,13.603,13.647,13.69,13.733,13.777,13.82,13.82,13.82,13.863,13.907,13.95,13.993,14.037,14.08,14.08,14.18,14.28,14.28,14.34,14.4,14.4,14.453,14.505,14.558,14.61,14.663,14.715,14.76