{"source":"chunk-4","from":0,"text":"Третье место — Друид на атаке. Самая популярная колода меты, и жёсткой контры против неё нет: она слегка уступает только трём агро колодам — Зи Шаману, ДК Нечестивости и Чистому Паладину. Сборок у Друида очень много, и отличаются они в основном лейтгеймом: кто-то обходится без него, кто-то берёт только Меритру из Сна, а кто-то — полный набор драконов с Наралексом. В последнее время стал популярен Жизнецвет, и сборки с ним сейчас выглядят лучше всего. Но главное в этой колоде не лейтгейм. Главное — найти Паучка на первый ход и разогнать эффект Заражения кладовой, чтобы как можно раньше задавить соперника большими статами.","start":[0,0.073,0.147,0.22,0.293,0.367,0.44,0.44,0.5,0.56,0.62,0.68,0.74,0.74,0.74,1.44,1.576,1.712,1.848,1.984,2.12,2.12,2.29,2.46,2.46,2.572,2.684,2.796,2.908,3.02,3.02,3.02,3.2,3.38,3.56,3.74,3.92,3.92,3.992,4.064,4.136,4.208,4.28,4.352,4.424,4.496,4.568,4.64,4.64,4.703,4.767,4.83,4.893,4.957,5.02,5.02,5.135,5.25,5.365,5.48,5.48,5.48,5.72,5.72,5.786,5.851,5.917,5.983,6.049,6.114,6.18,6.18,6.253,6.327,6.4,6.473,6.547,6.62,6.62,6.673,6.727,6.78,6.833,6.887,6.94,6.94,7.04,7.14,7.24,7.24,7.353,7.467,7.58,7.58,7.8,7.88,7.96,8.04,8.04,8.103,8.167,8.23,8.293,8.357,8.42,8.42,8.483,8.545,8.608,8.67,8.733,8.795,8.858,8.92,8.92,8.963,9.007,9.05,9.093,9.137,9.18,9.18,9.295,9.41,9.525,9.64,9.64,9.855,10.07,10.285,10.5,10.5,10.54,10.58,10.62,10.66,10.7,10.74,10.78,10.78,10.78,10.78,10.88,10.98,10.98,11.06,11.14,11.22,11.3,11.38,11.46,11.46,11.46,11.7,11.94,11.94,12.007,12.073,12.14,12.207,12.273,12.34,12.407,12.473,12.54,12.607,12.673,12.74,12.74,13.1,13.1,13.169,13.237,13.306,13.374,13.443,13.511,13.58,13.58,13.645,13.71,13.775,13.84,13.905,13.97,14.035,14.1,14.1,14.46,14.547,14.633,14.72,14.807,14.893,14.98,14.98,15.06,15.06,15.12,15.18,15.24,15.3,15.36,15.42,15.42,15.492,15.564,15.636,15.708,15.78,15.78,15.848,15.916,15.984,16.052,16.12,16.12,16.52,16.6,16.6,16.654,16.708,16.762,16.816,16.87,16.924,16.978,17.032,17.086