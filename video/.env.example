# Скопировать в video/.env и заполнить. Файл .env в git не попадает (.gitignore).

# ElevenLabs → Developers → API Keys. Права ключа: Text to Speech (достаточно), Voices — чтение
ELEVENLABS_API_KEY=

# Голос диктора (voice_id из библиотеки ElevenLabs) и модель
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
