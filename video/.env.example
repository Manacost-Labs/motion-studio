# Скопировать в video/.env и заполнить. Файл .env в git не попадает (.gitignore).

# ElevenLabs → Developers → API Keys. Права ключа: Text to Speech (достаточно), Voices — чтение
ELEVENLABS_API_KEY=

# Голос диктора (voice_id из библиотеки ElevenLabs) и модель
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4

# Koloda Hearthstone API (github.com/Manacost-Labs/api.kolodahearthstone.com). Публичные GET работают без токена;
# токен (khs_v1_…) — для закрытых операций, права видно на GET /v1/auth/token
KOLODA_API_TOKEN=

# Twitch API (dev.twitch.tv/console → Register Your Application, бесплатно; OAuth Redirect URL — http://localhost,
# категория Other, клиент Confidential). Нужен для поиска клипов по всей категории Hearthstone (eyes.mjs find --twitch);
# без ключей поиск идёт по списку каналов через yt-dlp
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# OpenRouter (openrouter.ai/settings/keys) — судья judge.mjs --backend openrouter и --visual (решающие модели Jev, Clef).
# Платно: сначала смета, отправка только с --yes; лимит трат лучше задать на самом ключе. Остаток — node scripts/credits.mjs
OPENROUTER_API_KEY=
